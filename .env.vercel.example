# Vercel 배포용 환경변수 설정 가이드
# Vercel Dashboard > Project Settings > Environment Variables에서 설정

# ============================================
# 필수 환경변수 (REQUIRED)
# ============================================

# Database - PostgreSQL Connection String
# Vercel Postgres, Supabase, Neon 등 사용 가능
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxxxx"
CLERK_SECRET_KEY="sk_live_xxxxx"

# Encryption Key (32-byte hex string)
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_64_character_hex_string_here"

# ============================================
# 선택 환경변수 (OPTIONAL)
# ============================================

# Upstash Redis (Rate Limiting & Caching)
# https://upstash.com
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_token_here"

# Cloudflare Turnstile (Bot Protection)
# https://dash.cloudflare.com
TURNSTILE_SECRET_KEY="0x4xxxxxxxxxxxxx"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4xxxxxxxxxxxxx"

# ============================================
# Clerk URLs (기본값 - 필요시 수정)
# ============================================

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
